<Window x:Class="AsdLasercraft.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AsdLasercraft.App.Controls"
        Title="A·S·D Lasercraft" Width="1440" Height="900" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen" Icon="/Assets/AsdLasercraft.ico"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">

    <DockPanel>
        <!-- ============================================================ Menu -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New" InputGestureText="Ctrl+N" Click="New_Click" />
                <MenuItem Header="_Open…" InputGestureText="Ctrl+O" Click="Open_Click" />
                <MenuItem Header="_Save" InputGestureText="Ctrl+S" Click="Save_Click" />
                <MenuItem Header="Save _As…" Click="SaveAs_Click" />
                <Separator />
                <MenuItem Header="Import _Image…" InputGestureText="Ctrl+I" Click="ImportImage_Click" />
                <MenuItem Header="Import S_VG…" Click="ImportSvg_Click" />
                <Separator />
                <MenuItem Header="_Export G-code…" InputGestureText="Ctrl+E" Click="ExportGcode_Click" />
                <Separator />
                <MenuItem Header="E_xit" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" InputGestureText="Ctrl+Z" Click="Undo_Click" />
                <MenuItem Header="_Redo" InputGestureText="Ctrl+Y" Click="Redo_Click" />
                <Separator />
                <MenuItem Header="_Duplicate" InputGestureText="Ctrl+D" Click="Duplicate_Click" />
                <MenuItem Header="_Delete" InputGestureText="Del" Click="Delete_Click" />
                <MenuItem Header="Select _All" InputGestureText="Ctrl+A" Click="SelectAll_Click" />
            </MenuItem>
            <MenuItem Header="_Arrange">
                <MenuItem Header="Rotate 90° clockwise" Click="RotateCw_Click" />
                <MenuItem Header="Rotate 90° anticlockwise" Click="RotateCcw_Click" />
                <MenuItem Header="Mirror horizontally" Click="MirrorH_Click" />
                <MenuItem Header="Mirror vertically" Click="MirrorV_Click" />
                <Separator />
                <MenuItem Header="Centre on bed" Click="CentreOnBed_Click" />
                <MenuItem Header="Move to origin (top-left)" Click="MoveToOrigin_Click" />
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="Material _test grid…" Click="MaterialTest_Click" />
                <MenuItem Header="_Machine settings…" Click="MachineSettings_Click" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Zoom to _fit" InputGestureText="F" Click="ZoomFit_Click" />
                <MenuItem x:Name="PreviewMenu" Header="_Preview raster (show dithered dots)" IsCheckable="True" Click="PreviewRaster_Click" />
                <MenuItem x:Name="SnapMenu" Header="_Snap to 1 mm grid" IsCheckable="True" IsChecked="True" Click="Snap_Click" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="A·S·D Lasercraft on _GitHub" Click="GitHub_Click" />
                <MenuItem Header="Report an _issue…" Click="ReportIssue_Click" />
                <Separator />
                <MenuItem Header="_About A·S·D Lasercraft" Click="About_Click" />
            </MenuItem>
        </Menu>

        <!-- ============================================================ Toolbar -->
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar x:Name="MainToolBar">
                <RadioButton GroupName="tools" Tag="Select" IsChecked="True" Checked="Tool_Checked" ToolTip="Select / move / resize (V)" Content="⬚ Select" Style="{StaticResource {x:Static ToolBar.RadioButtonStyleKey}}" />
                <RadioButton GroupName="tools" Tag="Rectangle" Checked="Tool_Checked" ToolTip="Rectangle (R) – Shift for square" Content="▭ Rect" Style="{StaticResource {x:Static ToolBar.RadioButtonStyleKey}}" />
                <RadioButton GroupName="tools" Tag="Ellipse" Checked="Tool_Checked" ToolTip="Ellipse (E) – Shift for circle" Content="◯ Ellipse" Style="{StaticResource {x:Static ToolBar.RadioButtonStyleKey}}" />
                <RadioButton GroupName="tools" Tag="Polygon" Checked="Tool_Checked" ToolTip="Polygon (G)" Content="⬡ Polygon" Style="{StaticResource {x:Static ToolBar.RadioButtonStyleKey}}" />
                <RadioButton GroupName="tools" Tag="Line" Checked="Tool_Checked" ToolTip="Line (L)" Content="╱ Line" Style="{StaticResource {x:Static ToolBar.RadioButtonStyleKey}}" />
                <RadioButton GroupName="tools" Tag="Pen" Checked="Tool_Checked" ToolTip="Pen: click points, double-click/Enter to finish, click first point to close (P)" Content="✎ Pen" Style="{StaticResource {x:Static ToolBar.RadioButtonStyleKey}}" />
                <RadioButton GroupName="tools" Tag="Text" Checked="Tool_Checked" ToolTip="Text (T)" Content="A Text" Style="{StaticResource {x:Static ToolBar.RadioButtonStyleKey}}" />
                <Separator />
                <Button Content="🖼 Image…" Click="ImportImage_Click" ToolTip="Import image" />
                <Button Content="⤓ SVG…" Click="ImportSvg_Click" ToolTip="Import SVG" />
                <Separator />
                <Button Content="↶" Click="Undo_Click" ToolTip="Undo (Ctrl+Z)" />
                <Button Content="↷" Click="Redo_Click" ToolTip="Redo (Ctrl+Y)" />
                <Separator />
                <Button Content="⤢ Fit" Click="ZoomFit_Click" ToolTip="Zoom to fit (F)" />
                <CheckBox x:Name="PreviewCheck" Content="Raster preview" Click="PreviewRaster_Click" ToolTip="Show images exactly as they will be dithered and burned" />
            </ToolBar>
        </ToolBarTray>

        <!-- ============================================================ Status bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem><TextBlock x:Name="CursorText" Text="X 0.0  Y 0.0 mm" MinWidth="150" /></StatusBarItem>
            <Separator />
            <StatusBarItem><TextBlock x:Name="SelectionText" Text="Nothing selected" MinWidth="220" /></StatusBarItem>
            <Separator />
            <StatusBarItem><TextBlock x:Name="JobText" Text="" MinWidth="200" /></StatusBarItem>
            <Separator />
            <StatusBarItem HorizontalAlignment="Right"><TextBlock x:Name="MachineText" Text="Not connected" /></StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="400" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <controls:DesignCanvas x:Name="Surface" Grid.Column="0" />
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" />

            <TabControl Grid.Column="2">
                <!-- ==================================================== Design tab -->
                <TabItem Header="Layers &amp; Design">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="6">
                            <GroupBox Header="Layers (burned top to bottom – put cuts last)">
                                <StackPanel>
                                    <DataGrid x:Name="LayersGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                              HeadersVisibility="Column" SelectionMode="Single" Height="190"
                                              SelectionChanged="LayersGrid_SelectionChanged" CellEditEnding="LayersGrid_CellEditEnding">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="" Width="22">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{Binding ColorHex}" Width="14" Height="14" CornerRadius="2" MouseLeftButtonDown="LayerColor_Click" Cursor="Hand" ToolTip="Click to change colour" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                            <DataGridComboBoxColumn x:Name="ModeColumn" Header="Mode" SelectedItemBinding="{Binding Mode}" Width="62" />
                                            <DataGridTextColumn Header="mm/min" Binding="{Binding SpeedMmMin}" Width="56" />
                                            <DataGridTextColumn Header="Power %" Binding="{Binding PowerPercent}" Width="56" />
                                            <DataGridTextColumn Header="Passes" Binding="{Binding Passes}" Width="46" />
                                            <DataGridCheckBoxColumn Header="Out" Binding="{Binding Output}" Width="32" />
                                            <DataGridCheckBoxColumn Header="Show" Binding="{Binding Visible}" Width="38" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <WrapPanel>
                                        <Button Content="+ Layer" Click="AddLayer_Click" />
                                        <Button Content="− Layer" Click="RemoveLayer_Click" />
                                        <Button Content="▲" Click="LayerUp_Click" ToolTip="Burn earlier" />
                                        <Button Content="▼" Click="LayerDown_Click" ToolTip="Burn later" />
                                        <Button Content="Move selection here" Click="AssignLayer_Click" ToolTip="Put the selected shapes on this layer" />
                                    </WrapPanel>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition /><RowDefinition /><RowDefinition />
                                        </Grid.RowDefinitions>
                                        <Label Content="Line interval mm" />
                                        <TextBox x:Name="IntervalBox" Grid.Column="1" LostFocus="LayerDetail_Changed" ToolTip="Fill/Image scan spacing. 0.1 mm ≈ 254 DPI" />
                                        <Label Content="Overscan mm" Grid.Column="2" />
                                        <TextBox x:Name="OverscanBox" Grid.Column="3" LostFocus="LayerDetail_Changed" />
                                        <Label Content="Min power %" Grid.Row="1" />
                                        <TextBox x:Name="MinPowerBox" Grid.Row="1" Grid.Column="1" LostFocus="LayerDetail_Changed" ToolTip="Grayscale images: power for the lightest grey" />
                                        <CheckBox x:Name="BidirCheck" Content="Bidirectional" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Click="LayerDetail_Changed" />
                                        <CheckBox x:Name="AirCheck" Content="Air assist (M8)" Grid.Row="2" Grid.ColumnSpan="2" Click="LayerDetail_Changed" />
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox x:Name="SelectionGroup" Header="Selection – position &amp; size (mm)">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>
                                    <Label Content="X" /><TextBox x:Name="XBox" Grid.Column="1" KeyDown="Geometry_KeyDown" LostFocus="Geometry_Commit" />
                                    <Label Content="Y" Grid.Column="2" /><TextBox x:Name="YBox" Grid.Column="3" KeyDown="Geometry_KeyDown" LostFocus="Geometry_Commit" />
                                    <Label Content="W" Grid.Row="1" /><TextBox x:Name="WBox" Grid.Row="1" Grid.Column="1" KeyDown="Geometry_KeyDown" LostFocus="Geometry_Commit" />
                                    <Label Content="H" Grid.Row="1" Grid.Column="2" /><TextBox x:Name="HBox" Grid.Row="1" Grid.Column="3" KeyDown="Geometry_KeyDown" LostFocus="Geometry_Commit" />
                                    <CheckBox x:Name="LockAspect" Content="Lock aspect ratio" IsChecked="True" Grid.Row="2" Grid.ColumnSpan="2" />
                                    <Label Content="Rotate °" Grid.Row="2" Grid.Column="2" />
                                    <TextBox x:Name="RotateBox" Grid.Row="2" Grid.Column="3" Text="0" KeyDown="Rotate_KeyDown" ToolTip="Type an angle and press Enter (vectors only)" />
                                    <WrapPanel Grid.Row="3" Grid.ColumnSpan="4">
                                        <Button Content="⟳ 90°" Click="RotateCw_Click" />
                                        <Button Content="⟲ 90°" Click="RotateCcw_Click" />
                                        <Button Content="⇋ Mirror" Click="MirrorH_Click" />
                                        <Button Content="⇵ Flip" Click="MirrorV_Click" />
                                        <Button Content="Centre" Click="CentreOnBed_Click" />
                                    </WrapPanel>
                                </Grid>
                            </GroupBox>

                            <GroupBox x:Name="ImageGroup" Header="Image settings" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>
                                    <Label Content="Mode" />
                                    <ComboBox x:Name="DitherCombo" Grid.Column="1" Grid.ColumnSpan="2" SelectionChanged="ImageSetting_Changed" />
                                    <Label Content="Brightness" Grid.Row="1" />
                                    <Slider x:Name="BrightnessSlider" Grid.Row="1" Grid.Column="1" Minimum="-100" Maximum="100" ValueChanged="ImageSetting_Changed" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Value, ElementName=BrightnessSlider, StringFormat=0}" VerticalAlignment="Center" />
                                    <Label Content="Contrast" Grid.Row="2" />
                                    <Slider x:Name="ContrastSlider" Grid.Row="2" Grid.Column="1" Minimum="-100" Maximum="100" ValueChanged="ImageSetting_Changed" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Value, ElementName=ContrastSlider, StringFormat=0}" VerticalAlignment="Center" />
                                    <Label Content="Gamma" Grid.Row="3" />
                                    <Slider x:Name="GammaSlider" Grid.Row="3" Grid.Column="1" Minimum="0.2" Maximum="3" Value="1" ValueChanged="ImageSetting_Changed" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Value, ElementName=GammaSlider, StringFormat=0.00}" VerticalAlignment="Center" />
                                    <Label Content="Threshold" Grid.Row="4" />
                                    <Slider x:Name="ThresholdSlider" Grid.Row="4" Grid.Column="1" Minimum="1" Maximum="254" Value="128" ValueChanged="ImageSetting_Changed" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding Value, ElementName=ThresholdSlider, StringFormat=0}" VerticalAlignment="Center" />
                                    <CheckBox x:Name="InvertCheck" Content="Invert (for dark materials / slate)" Grid.Row="5" Grid.ColumnSpan="3" Click="ImageSetting_Changed" />
                                </Grid>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ==================================================== Laser tab -->
                <TabItem Header="Laser">
                    <DockPanel Margin="6">
                        <StackPanel DockPanel.Dock="Top">
                            <GroupBox Header="Connection (GRBL over USB)">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="90" /><ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="PortCombo" />
                                    <Button Grid.Column="1" Content="⟳" Click="RefreshPorts_Click" ToolTip="Refresh ports" />
                                    <ComboBox x:Name="BaudCombo" Grid.Column="2" IsEditable="True" Text="115200">
                                        <ComboBoxItem>115200</ComboBoxItem>
                                        <ComboBoxItem>250000</ComboBoxItem>
                                        <ComboBoxItem>230400</ComboBoxItem>
                                        <ComboBoxItem>57600</ComboBoxItem>
                                    </ComboBox>
                                    <Button x:Name="ConnectButton" Grid.Column="3" Content="Connect" Click="Connect_Click" MinWidth="90" />
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Machine">
                                <StackPanel>
                                    <WrapPanel>
                                        <Button Content="⌂ Home ($H)" Click="Home_Click" />
                                        <Button Content="Unlock ($X)" Click="Unlock_Click" />
                                        <Button Content="Set work origin here" Click="SetOrigin_Click" ToolTip="G10 L20 P1 X0 Y0 – current head position becomes X0 Y0" />
                                    </WrapPanel>
                                    <Grid HorizontalAlignment="Left" Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" /><ColumnDefinition Width="44" /><ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition /><RowDefinition /><RowDefinition />
                                        </Grid.RowDefinitions>
                                        <Button Grid.Column="1" Content="▲" Tag="0,1" Click="Jog_Click" ToolTip="Jog +Y (away)" />
                                        <Button Grid.Row="1" Content="◀" Tag="-1,0" Click="Jog_Click" />
                                        <Button Grid.Row="1" Grid.Column="1" Content="■" Click="JogCancel_Click" ToolTip="Stop jog" />
                                        <Button Grid.Row="1" Grid.Column="2" Content="▶" Tag="1,0" Click="Jog_Click" />
                                        <Button Grid.Row="2" Grid.Column="1" Content="▼" Tag="0,-1" Click="Jog_Click" />
                                        <Label Grid.Column="3" Content="Step mm" />
                                        <ComboBox x:Name="JogStepCombo" Grid.Column="4" SelectedIndex="2">
                                            <ComboBoxItem>0.1</ComboBoxItem>
                                            <ComboBoxItem>1</ComboBoxItem>
                                            <ComboBoxItem>10</ComboBoxItem>
                                            <ComboBoxItem>50</ComboBoxItem>
                                        </ComboBox>
                                        <Label Grid.Row="1" Grid.Column="3" Content="Jog mm/min" />
                                        <TextBox x:Name="JogFeedBox" Grid.Row="1" Grid.Column="4" Text="3000" />
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Job">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="60" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="70" />
                                        </Grid.ColumnDefinitions>
                                        <Label Content="Frame power %" />
                                        <TextBox x:Name="FramePowerBox" Grid.Column="1" Text="0" ToolTip="0 = head moves only. 1–2 % shows a faint dot on most diode lasers without marking." />
                                        <Label Grid.Column="2" Content="Frame mm/min" />
                                        <TextBox x:Name="FrameSpeedBox" Grid.Column="3" Text="3000" />
                                    </Grid>
                                    <CheckBox x:Name="SelectedOnlyCheck" Content="Burn / frame selected shapes only" />
                                    <WrapPanel Margin="0,4,0,0">
                                        <Button Content="⬚ Frame" Click="Frame_Click" ToolTip="Trace the job outline to check size and placement before burning" />
                                        <Button x:Name="StartButton" Content="▶ Start" Click="Start_Click" FontWeight="Bold" />
                                        <Button x:Name="PauseButton" Content="❚❚ Pause" Click="Pause_Click" IsEnabled="False" />
                                        <Button x:Name="StopButton" Content="■ Stop" Click="Stop_Click" Foreground="Firebrick" FontWeight="Bold" />
                                    </WrapPanel>
                                    <ProgressBar x:Name="JobProgress" Height="16" Margin="2,6,2,2" />
                                    <TextBlock x:Name="JobProgressText" Margin="2" Text="Idle" />
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Console">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Send" Click="SendCommand_Click" />
                                    <TextBox x:Name="CommandBox" KeyDown="CommandBox_KeyDown" ToolTip="Any GRBL command, e.g. $$ to list settings" />
                                </DockPanel>
                            </GroupBox>
                        </StackPanel>
                        <ListBox x:Name="ConsoleList" FontFamily="Consolas" FontSize="11" Margin="0,4,0,0" />
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
