<Window x:Class="AsdLasercraft.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:AsdLasercraft.App.Controls"
        Style="{StaticResource AppWindow}"
        Title="A·S·D Lasercraft" Width="1480" Height="920" MinWidth="1100" MinHeight="640"
        WindowStartupLocation="CenterScreen" Icon="/Assets/AsdLasercraft.ico"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================================================ top bar -->
        <Border Grid.Row="0" Background="{StaticResource Brush.HeaderGradient}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="10,3">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,2,0">
                    <Image Source="/Assets/logo-256.png" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Margin="9,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource Font.Display}">
                        <Run Text="A·S·D" Foreground="{StaticResource Brush.Accent}" FontWeight="Black" FontSize="15" /><Run Text=" LASERCRAFT" Foreground="{StaticResource Brush.TextMuted}" FontWeight="SemiBold" FontSize="11" />
                    </TextBlock>
                </StackPanel>
                <Border DockPanel.Dock="Left" Style="{StaticResource VDivider}" />

                <Menu DockPanel.Dock="Left">
                    <MenuItem Header="_File">
                        <MenuItem Header="_New" InputGestureText="Ctrl+N" Click="New_Click" />
                        <MenuItem Header="_Open…" InputGestureText="Ctrl+O" Click="Open_Click" />
                        <MenuItem x:Name="RecentMenu" Header="Open _recent" />
                        <MenuItem Header="_Save" InputGestureText="Ctrl+S" Click="Save_Click" />
                        <MenuItem Header="Save _as…" InputGestureText="Ctrl+Shift+S" Click="SaveAs_Click" />
                        <Separator />
                        <MenuItem Header="Import _image…" InputGestureText="Ctrl+I" Click="ImportImage_Click" />
                        <MenuItem Header="Import S_VG…" Click="ImportSvg_Click" />
                        <Separator />
                        <MenuItem Header="_Export G-code…" InputGestureText="Ctrl+E" Click="ExportGcode_Click" />
                        <Separator />
                        <MenuItem Header="E_xit" Click="Exit_Click" />
                    </MenuItem>
                    <MenuItem Header="_Edit">
                        <MenuItem Header="_Undo" InputGestureText="Ctrl+Z" Click="Undo_Click" />
                        <MenuItem Header="_Redo" InputGestureText="Ctrl+Y" Click="Redo_Click" />
                        <Separator />
                        <MenuItem Header="_Duplicate" InputGestureText="Ctrl+D" Click="Duplicate_Click" />
                        <MenuItem Header="De_lete" InputGestureText="Del" Click="Delete_Click" />
                        <MenuItem Header="Select _all" InputGestureText="Ctrl+A" Click="SelectAll_Click" />
                        <Separator />
                        <MenuItem Header="_Grid array…" Click="ArrayGrid_Click" />
                        <MenuItem Header="_Circular array…" Click="ArrayCircular_Click" />
                    </MenuItem>
                    <MenuItem Header="_Arrange">
                        <MenuItem Header="Rotate 90° clockwise" Click="RotateCw_Click" />
                        <MenuItem Header="Rotate 90° anticlockwise" Click="RotateCcw_Click" />
                        <MenuItem Header="Mirror horizontally" Click="MirrorH_Click" />
                        <MenuItem Header="Mirror vertically" Click="MirrorV_Click" />
                        <Separator />
                        <MenuItem Header="Centre on bed" Click="CentreOnBed_Click" />
                        <MenuItem Header="Move to origin (top left)" Click="MoveToOrigin_Click" />
                    </MenuItem>
                    <MenuItem Header="_Tools">
                        <MenuItem Header="_Material library…" InputGestureText="Ctrl+M" Click="MaterialLibrary_Click" />
                        <MenuItem Header="Trace _image to vectors…" Click="TraceImage_Click" />
                        <Separator />
                        <MenuItem Header="Material _test grid…" Click="MaterialTest_Click" />
                        <MenuItem Header="_Scan offset test card…" Click="ScanOffsetTest_Click" />
                        <Separator />
                        <MenuItem Header="Machine _settings…" Click="MachineSettings_Click" />
                    </MenuItem>
                    <MenuItem Header="_View">
                        <MenuItem Header="Zoom to _fit" InputGestureText="F" Click="ZoomFit_Click" />
                        <MenuItem Header="Zoom _in" InputGestureText="+" Click="ZoomIn_Click" />
                        <MenuItem Header="Zoom _out" InputGestureText="−" Click="ZoomOut_Click" />
                        <Separator />
                        <MenuItem x:Name="SimulateMenu" Header="_Simulated preview" InputGestureText="Ctrl+P" IsCheckable="True" Click="Simulate_Click" />
                        <MenuItem x:Name="PreviewMenu" Header="_Raster preview (show dithered dots)" IsCheckable="True" Click="PreviewRaster_Click" />
                        <Separator />
                        <MenuItem x:Name="SnapMenu" Header="S_nap to 1 mm grid" IsCheckable="True" IsChecked="True" Click="Snap_Click" />
                        <MenuItem x:Name="RulersMenu" Header="Show r_ulers" IsCheckable="True" IsChecked="True" Click="Rulers_Click" />
                        <MenuItem x:Name="SplashMenu" Header="Show splash screen at start" IsCheckable="True" IsChecked="True" Click="Splash_Click" />
                    </MenuItem>
                    <MenuItem Header="_Help">
                        <MenuItem Header="A·S·D Lasercraft on _GitHub" Click="GitHub_Click" />
                        <MenuItem Header="Report an _issue…" Click="ReportIssue_Click" />
                        <Separator />
                        <MenuItem Header="Check for _updates" Click="CheckUpdates_Click" />
                        <MenuItem x:Name="AutoUpdateMenu" Header="Check for updates automatically" IsCheckable="True" IsChecked="True" Click="AutoUpdate_Click" />
                        <Separator />
                        <MenuItem Header="_About A·S·D Lasercraft" Click="About_Click" />
                    </MenuItem>
                </Menu>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButton}" Click="New_Click" ToolTip="New project (Ctrl+N)"><c:Glyph Data="{StaticResource I.New}" Size="17" /></Button>
                    <Button Style="{StaticResource GhostButton}" Click="Open_Click" ToolTip="Open (Ctrl+O)"><c:Glyph Data="{StaticResource I.Open}" Size="17" /></Button>
                    <Button Style="{StaticResource GhostButton}" Click="Save_Click" ToolTip="Save (Ctrl+S)"><c:Glyph Data="{StaticResource I.Save}" Size="17" /></Button>
                    <Border Style="{StaticResource VDivider}" Margin="6,8" />
                    <Button Style="{StaticResource GhostButton}" Click="Undo_Click" ToolTip="Undo (Ctrl+Z)"><c:Glyph Data="{StaticResource I.Undo}" Size="17" /></Button>
                    <Button Style="{StaticResource GhostButton}" Click="Redo_Click" ToolTip="Redo (Ctrl+Y)"><c:Glyph Data="{StaticResource I.Redo}" Size="17" /></Button>
                    <Border Style="{StaticResource VDivider}" Margin="6,8" />
                    <Button Style="{StaticResource GhostButton}" Click="MaterialLibrary_Click" ToolTip="Material library (Ctrl+M)"><c:Glyph Data="{StaticResource I.Material}" Size="17" /></Button>
                    <Button Style="{StaticResource GhostButton}" Click="MachineSettings_Click" ToolTip="Machine settings"><c:Glyph Data="{StaticResource I.Settings}" Size="17" /></Button>
                    <Button Click="ExportGcode_Click" ToolTip="Export G-code (Ctrl+E)" Margin="8,2,2,2">
                        <c:Glyph Data="{StaticResource I.Export}" Text="Export" Size="16" />
                    </Button>
                </StackPanel>
                <Border />
            </DockPanel>
        </Border>

        <!-- ============================================================ update banner -->
        <Border x:Name="UpdateBanner" Grid.Row="1" Visibility="Collapsed" Background="#1F4CB5FF" BorderBrush="#404CB5FF" BorderThickness="0,0,0,1" Padding="16,6">
            <DockPanel>
                <c:Glyph DockPanel.Dock="Left" Data="{StaticResource I.Update}" Foreground="{StaticResource Brush.Info}" Size="17" Margin="0,0,10,0" />
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Click="UpdateDismiss_Click" ToolTip="Hide"><c:Glyph Data="{StaticResource I.Close}" Size="14" /></Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Click="UpdateSkip_Click" Content="Skip this version" />
                <Button DockPanel.Dock="Right" Click="UpdateView_Click" Content="View release" />
                <TextBlock x:Name="UpdateText" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- ============================================================ work area -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="58" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="436" MinWidth="370" />
            </Grid.ColumnDefinitions>

            <!-- tool rail -->
            <Border Grid.Column="0" Background="{StaticResource Brush.Panel}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <ToggleButton x:Name="SimulateToggle" Style="{StaticResource RailToggle}" Click="Simulate_Click" ToolTip="Simulated preview – play the job before burning (Ctrl+P)">
                            <c:Glyph Data="{StaticResource I.Simulate}" />
                        </ToggleButton>
                        <ToggleButton x:Name="PreviewCheck" Style="{StaticResource RailToggle}" Click="PreviewRaster_Click" ToolTip="Raster preview – show images exactly as they will be dithered and burned">
                            <c:Glyph Data="{StaticResource I.Eye}" />
                        </ToggleButton>
                        <Button Style="{StaticResource RailButton}" Click="ZoomFit_Click" ToolTip="Zoom to fit (F)">
                            <c:Glyph Data="{StaticResource I.Fit}" />
                        </Button>
                    </StackPanel>
                    <StackPanel x:Name="ToolRail" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <RadioButton GroupName="tools" Tag="Select" IsChecked="True" Checked="Tool_Checked" Style="{StaticResource RailRadio}" ToolTip="Select, move and resize (V)">
                            <c:Glyph Data="{StaticResource I.Select}" />
                        </RadioButton>
                        <RadioButton GroupName="tools" Tag="Rectangle" Checked="Tool_Checked" Style="{StaticResource RailRadio}" ToolTip="Rectangle (R) – hold Shift for a square">
                            <c:Glyph Data="{StaticResource I.Rect}" />
                        </RadioButton>
                        <RadioButton GroupName="tools" Tag="Ellipse" Checked="Tool_Checked" Style="{StaticResource RailRadio}" ToolTip="Ellipse (E) – hold Shift for a circle">
                            <c:Glyph Data="{StaticResource I.Ellipse}" />
                        </RadioButton>
                        <RadioButton GroupName="tools" Tag="Polygon" Checked="Tool_Checked" Style="{StaticResource RailRadio}" ToolTip="Polygon (G)">
                            <c:Glyph Data="{StaticResource I.Polygon}" />
                        </RadioButton>
                        <RadioButton GroupName="tools" Tag="Line" Checked="Tool_Checked" Style="{StaticResource RailRadio}" ToolTip="Line (L)">
                            <c:Glyph Data="{StaticResource I.Line}" />
                        </RadioButton>
                        <RadioButton GroupName="tools" Tag="Pen" Checked="Tool_Checked" Style="{StaticResource RailRadio}" ToolTip="Pen (P) – click points, double-click or Enter to finish, click the first point to close">
                            <c:Glyph Data="{StaticResource I.Pen}" />
                        </RadioButton>
                        <RadioButton GroupName="tools" Tag="Text" Checked="Tool_Checked" Style="{StaticResource RailRadio}" ToolTip="Text (T) – any installed font">
                            <c:Glyph Data="{StaticResource I.Text}" />
                        </RadioButton>
                        <Border Height="1" Width="28" Margin="0,8" Background="{StaticResource Brush.Border}" />
                        <Button Style="{StaticResource RailButton}" Click="ImportImage_Click" ToolTip="Import image (Ctrl+I)">
                            <c:Glyph Data="{StaticResource I.Image}" />
                        </Button>
                        <Button Style="{StaticResource RailButton}" Click="ImportSvg_Click" ToolTip="Import SVG">
                            <c:Glyph Data="{StaticResource I.Import}" />
                        </Button>
                        <Button Style="{StaticResource RailButton}" Click="TraceImage_Click" ToolTip="Trace the selected image into vector outlines">
                            <c:Glyph Data="{StaticResource I.Trace}" />
                        </Button>
                        <Button Style="{StaticResource RailButton}" Click="ArrayGrid_Click" ToolTip="Grid array – copy the selection into rows and columns">
                            <c:Glyph Data="{StaticResource I.Array}" />
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- canvas + overlays -->
            <Grid Grid.Column="1" ClipToBounds="True">
                <c:DesignCanvas x:Name="Surface" />

                <!-- zoom pill -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,34,14,0" Padding="4,2" CornerRadius="10"
                        Background="#E61A1E25" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource GhostButton}" MinHeight="26" Padding="6,3" Click="ZoomOut_Click" ToolTip="Zoom out (−)"><c:Glyph Data="{StaticResource I.Minus}" Size="14" /></Button>
                        <TextBlock x:Name="ZoomText" Text="100%" Width="46" TextAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextMuted}" FontSize="12" />
                        <Button Style="{StaticResource GhostButton}" MinHeight="26" Padding="6,3" Click="ZoomIn_Click" ToolTip="Zoom in (+)"><c:Glyph Data="{StaticResource I.Plus}" Size="14" /></Button>
                        <Button Style="{StaticResource GhostButton}" MinHeight="26" Padding="6,3" Click="ZoomFit_Click" ToolTip="Fit bed (F)"><c:Glyph Data="{StaticResource I.Fit}" Size="14" /></Button>
                    </StackPanel>
                </Border>

                <!-- toast -->
                <Border x:Name="Toast" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,36,0,0" Padding="16,10" CornerRadius="12"
                        Background="#F2222731" BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1" Visibility="Collapsed" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.55" Color="Black" />
                    </Border.Effect>
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="ToastShift" />
                    </Border.RenderTransform>
                    <StackPanel Orientation="Horizontal">
                        <c:Glyph x:Name="ToastGlyph" Data="{StaticResource I.Success}" Foreground="{StaticResource Brush.Success}" Size="20" Margin="0,0,10,0" />
                        <TextBlock x:Name="ToastText" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>

                <!-- simulated preview bar -->
                <Border x:Name="SimBar" VerticalAlignment="Bottom" Margin="40,0,40,18" Padding="14,10" CornerRadius="14"
                        Background="#F21A1E25" BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1" Visibility="Collapsed">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity="0.6" Color="Black" />
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="2,0,2,6">
                            <TextBlock DockPanel.Dock="Left" Text="SIMULATED PREVIEW" Style="{StaticResource Caption}" Margin="0" Foreground="{StaticResource Brush.Accent}" />
                            <TextBlock x:Name="SimInfoText" Style="{StaticResource Caption}" Margin="12,0,0,0" />
                        </DockPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="SimPlayButton" Style="{StaticResource PrimaryButton}" Width="40" Padding="0" Click="SimPlay_Click" ToolTip="Play / pause (Space)">
                                <c:Glyph x:Name="SimPlayGlyph" Data="{StaticResource I.Play}" Size="16" />
                            </Button>
                            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Click="SimRestart_Click" ToolTip="Back to the start">
                                <c:Glyph Data="{StaticResource I.RotateCcw}" Size="16" />
                            </Button>
                            <Slider x:Name="SimSlider" Grid.Column="2" Margin="8,0" Minimum="0" Maximum="1" ValueChanged="SimSlider_ValueChanged" VerticalAlignment="Center" />
                            <TextBlock x:Name="SimTimeText" Grid.Column="3" Text="0:00 / 0:00" Width="150" TextAlignment="Center" VerticalAlignment="Center"
                                       FontFamily="{StaticResource Font.Mono}" Foreground="{StaticResource Brush.TextMuted}" />
                            <ComboBox x:Name="SimSpeedCombo" Grid.Column="4" Width="78" SelectedIndex="2" SelectionChanged="SimSpeed_Changed" ToolTip="Playback speed">
                                <ComboBoxItem>1×</ComboBoxItem>
                                <ComboBoxItem>5×</ComboBoxItem>
                                <ComboBoxItem>20×</ComboBoxItem>
                                <ComboBoxItem>100×</ComboBoxItem>
                                <ComboBoxItem>500×</ComboBoxItem>
                            </ComboBox>
                            <ToggleButton x:Name="SimTravelToggle" Grid.Column="5" Style="{StaticResource PillToggle}" IsChecked="True" Click="SimTravel_Click"
                                          ToolTip="Show laser-off travel moves">
                                <TextBlock Text="Travel" FontSize="12" />
                            </ToggleButton>
                            <Button Grid.Column="6" Style="{StaticResource GhostButton}" Click="SimClose_Click" ToolTip="Close preview (Esc)">
                                <c:Glyph Data="{StaticResource I.Close}" Size="15" />
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="2" HorizontalAlignment="Stretch" />

            <!-- ============================================================ side panel -->
            <Border Grid.Column="3" Background="{StaticResource Brush.Window}">
                <TabControl x:Name="RightTabs">
                    <!-- ==================================================== Design tab -->
                    <TabItem>
                        <TabItem.Header>
                            <c:Glyph Data="{StaticResource I.Layers}" Text="Design" Size="15" />
                        </TabItem.Header>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="12,2,12,12">
                                <GroupBox Header="Layers">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Muted}" FontSize="11.5" Margin="2,0,2,6" Text="Burned top to bottom – keep cuts last." />
                                        <DataGrid x:Name="LayersGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                                  CanUserReorderColumns="False" CanUserResizeRows="False" SelectionMode="Single" MinHeight="110" MaxHeight="230" FontSize="12.5"
                                                  SelectionChanged="LayersGrid_SelectionChanged" CellEditEnding="LayersGrid_CellEditEnding">
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="" Width="24">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{Binding ColorHex}" Width="14" Height="14" CornerRadius="4" MouseLeftButtonDown="LayerColor_Click"
                                                                    Cursor="Hand" ToolTip="Click to change colour" BorderBrush="#30FFFFFF" BorderThickness="1" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                                <DataGridComboBoxColumn x:Name="ModeColumn" Header="Mode" SelectedItemBinding="{Binding Mode}" Width="66" />
                                                <DataGridTextColumn Header="Speed" Binding="{Binding SpeedMmMin}" Width="54" />
                                                <DataGridTextColumn Header="Power" Binding="{Binding PowerPercent}" Width="46" />
                                                <DataGridTextColumn Header="Pass" Binding="{Binding Passes}" Width="34" />
                                                <DataGridCheckBoxColumn Header="Out" Binding="{Binding Output}" Width="32"
                                                                        ElementStyle="{StaticResource {x:Type CheckBox}}" EditingElementStyle="{StaticResource {x:Type CheckBox}}" />
                                                <DataGridCheckBoxColumn Header="Show" Binding="{Binding Visible}" Width="38"
                                                                        ElementStyle="{StaticResource {x:Type CheckBox}}" EditingElementStyle="{StaticResource {x:Type CheckBox}}" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <WrapPanel Margin="0,6,0,0">
                                            <Button Click="AddLayer_Click" ToolTip="Add a layer"><c:Glyph Data="{StaticResource I.Plus}" Size="14" /></Button>
                                            <Button Click="RemoveLayer_Click" ToolTip="Delete the selected layer"><c:Glyph Data="{StaticResource I.Minus}" Size="14" /></Button>
                                            <Button Click="LayerUp_Click" ToolTip="Burn earlier"><c:Glyph Data="{StaticResource I.ChevronUp}" Size="14" /></Button>
                                            <Button Click="LayerDown_Click" ToolTip="Burn later"><c:Glyph Data="{StaticResource I.ChevronDown}" Size="14" /></Button>
                                            <Button Click="AssignLayer_Click" Content="Move selection here" ToolTip="Put the selected shapes on this layer" />
                                            <Button Click="MaterialLibrary_Click" ToolTip="Apply saved material settings to this layer">
                                                <c:Glyph Data="{StaticResource I.Material}" Text="Material" Size="14" />
                                            </Button>
                                        </WrapPanel>
                                        <TextBlock x:Name="MaterialText" Style="{StaticResource Muted}" FontSize="11.5" Margin="4,4,2,0" Visibility="Collapsed" />

                                        <TextBlock Text="LAYER SETTINGS" Style="{StaticResource Caption}" Margin="2,12,2,4" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition /><RowDefinition /><RowDefinition />
                                            </Grid.RowDefinitions>
                                            <Label Content="Line interval" />
                                            <TextBox x:Name="IntervalBox" Grid.Column="1" LostFocus="LayerDetail_Changed" ToolTip="Fill and image scan spacing, mm. 0.1 mm ≈ 254 DPI." />
                                            <Label Content="Overscan" Grid.Column="2" />
                                            <TextBox x:Name="OverscanBox" Grid.Column="3" LostFocus="LayerDetail_Changed" ToolTip="Distance the head runs past each row end so it is at speed while burning, mm." />
                                            <Label Content="Min power" Grid.Row="1" />
                                            <TextBox x:Name="MinPowerBox" Grid.Row="1" Grid.Column="1" LostFocus="LayerDetail_Changed" ToolTip="Grayscale images: power for the lightest grey, %." />
                                            <CheckBox x:Name="BidirCheck" Content="Bidirectional" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Margin="8,5,2,5" Click="LayerDetail_Changed"
                                                      ToolTip="Scan in both directions (faster). Set scan offset in Machine settings if edges look fuzzy." />
                                            <CheckBox x:Name="AirCheck" Content="Air assist (M8)" Grid.Row="2" Grid.ColumnSpan="2" Click="LayerDetail_Changed" />
                                        </Grid>
                                        <Grid x:Name="FillOptions" Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Label Content="Fill angle °" />
                                            <TextBox x:Name="FillAngleBox" Grid.Column="1" LostFocus="LayerDetail_Changed" ToolTip="Direction of the scan lines: 0 = horizontal, 45 = diagonal, 90 = vertical." />
                                            <CheckBox x:Name="CrossHatchCheck" Content="Cross-hatch" Grid.Column="2" Margin="10,5,2,5" Click="LayerDetail_Changed"
                                                      ToolTip="Burn a second pass at 90° to the first for darker, more even engraving." />
                                        </Grid>
                                        <Grid x:Name="CutOptions" Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Label Content="Kerf" />
                                            <TextBox x:Name="KerfBox" Grid.Column="1" LostFocus="LayerDetail_Changed"
                                                     ToolTip="Width of the cut, mm (typically 0.1–0.2 on a diode). Outlines are offset by half so parts come out at the drawn size." />
                                            <Label Content="Tabs" Grid.Column="2" Margin="6,0,0,0" />
                                            <TextBox x:Name="TabCountBox" Grid.Column="3" LostFocus="LayerDetail_Changed" ToolTip="Number of uncut bridges per part outline, so parts don't drop out." />
                                            <Label Content="Width" Grid.Column="4" Margin="6,0,0,0" />
                                            <TextBox x:Name="TabWidthBox" Grid.Column="5" LostFocus="LayerDetail_Changed" ToolTip="Length of each tab, mm." />
                                        </Grid>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox x:Name="SelectionGroup" Header="Selection">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                        </Grid.RowDefinitions>
                                        <Label Content="X" /><TextBox x:Name="XBox" Grid.Column="1" KeyDown="Geometry_KeyDown" LostFocus="Geometry_Commit" />
                                        <Label Content="Y" Grid.Column="2" Margin="6,0,0,0" /><TextBox x:Name="YBox" Grid.Column="3" KeyDown="Geometry_KeyDown" LostFocus="Geometry_Commit" />
                                        <Label Content="W" Grid.Row="1" /><TextBox x:Name="WBox" Grid.Row="1" Grid.Column="1" KeyDown="Geometry_KeyDown" LostFocus="Geometry_Commit" />
                                        <Label Content="H" Grid.Row="1" Grid.Column="2" Margin="6,0,0,0" /><TextBox x:Name="HBox" Grid.Row="1" Grid.Column="3" KeyDown="Geometry_KeyDown" LostFocus="Geometry_Commit" />
                                        <CheckBox x:Name="LockAspect" Content="Lock aspect ratio" IsChecked="True" Grid.Row="2" Grid.ColumnSpan="2" />
                                        <Label Content="Rotate °" Grid.Row="2" Grid.Column="2" Margin="6,0,0,0" />
                                        <TextBox x:Name="RotateBox" Grid.Row="2" Grid.Column="3" Text="0" KeyDown="Rotate_KeyDown" ToolTip="Type an angle and press Enter (vectors only)" />
                                        <WrapPanel Grid.Row="3" Grid.ColumnSpan="4" Margin="0,4,0,0">
                                            <Button Click="RotateCw_Click" ToolTip="Rotate 90° clockwise"><c:Glyph Data="{StaticResource I.Rotate}" Size="15" /></Button>
                                            <Button Click="RotateCcw_Click" ToolTip="Rotate 90° anticlockwise"><c:Glyph Data="{StaticResource I.RotateCcw}" Size="15" /></Button>
                                            <Button Click="MirrorH_Click" ToolTip="Mirror left–right"><c:Glyph Data="{StaticResource I.Mirror}" Size="15" /></Button>
                                            <Button Click="MirrorV_Click" ToolTip="Flip top–bottom"><c:Glyph Data="{StaticResource I.Flip}" Size="15" /></Button>
                                            <Button Click="CentreOnBed_Click" ToolTip="Centre on the bed"><c:Glyph Data="{StaticResource I.Centre}" Size="15" /></Button>
                                            <Button Click="Duplicate_Click" ToolTip="Duplicate (Ctrl+D)"><c:Glyph Data="{StaticResource I.Duplicate}" Size="15" /></Button>
                                            <Button Click="ArrayGrid_Click" ToolTip="Grid array"><c:Glyph Data="{StaticResource I.Array}" Size="15" /></Button>
                                            <Button Click="Delete_Click" ToolTip="Delete (Del)" Style="{StaticResource DangerButton}"><c:Glyph Data="{StaticResource I.Delete}" Size="15" /></Button>
                                        </WrapPanel>
                                    </Grid>
                                </GroupBox>

                                <GroupBox x:Name="ImageGroup" Header="Image" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="44" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                        </Grid.RowDefinitions>
                                        <Label Content="Mode" />
                                        <ComboBox x:Name="DitherCombo" Grid.Column="1" Grid.ColumnSpan="2" SelectionChanged="ImageSetting_Changed" />
                                        <Label Content="Brightness" Grid.Row="1" />
                                        <Slider x:Name="BrightnessSlider" Grid.Row="1" Grid.Column="1" Minimum="-100" Maximum="100" ValueChanged="ImageSetting_Changed" />
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Value, ElementName=BrightnessSlider, StringFormat=0}" VerticalAlignment="Center" TextAlignment="Right" Foreground="{StaticResource Brush.TextMuted}" />
                                        <Label Content="Contrast" Grid.Row="2" />
                                        <Slider x:Name="ContrastSlider" Grid.Row="2" Grid.Column="1" Minimum="-100" Maximum="100" ValueChanged="ImageSetting_Changed" />
                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Value, ElementName=ContrastSlider, StringFormat=0}" VerticalAlignment="Center" TextAlignment="Right" Foreground="{StaticResource Brush.TextMuted}" />
                                        <Label Content="Gamma" Grid.Row="3" />
                                        <Slider x:Name="GammaSlider" Grid.Row="3" Grid.Column="1" Minimum="0.2" Maximum="3" Value="1" ValueChanged="ImageSetting_Changed" />
                                        <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Value, ElementName=GammaSlider, StringFormat=0.00}" VerticalAlignment="Center" TextAlignment="Right" Foreground="{StaticResource Brush.TextMuted}" />
                                        <Label Content="Threshold" Grid.Row="4" />
                                        <Slider x:Name="ThresholdSlider" Grid.Row="4" Grid.Column="1" Minimum="1" Maximum="254" Value="128" ValueChanged="ImageSetting_Changed" />
                                        <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding Value, ElementName=ThresholdSlider, StringFormat=0}" VerticalAlignment="Center" TextAlignment="Right" Foreground="{StaticResource Brush.TextMuted}" />
                                        <CheckBox x:Name="InvertCheck" Content="Invert (dark materials, slate)" Grid.Row="5" Grid.ColumnSpan="3" Click="ImageSetting_Changed" />
                                        <Button Grid.Row="6" Grid.ColumnSpan="3" HorizontalAlignment="Left" Click="TraceImage_Click" ToolTip="Turn the image into vector outlines you can cut or fill">
                                            <c:Glyph Data="{StaticResource I.Trace}" Text="Trace to vectors" Size="15" />
                                        </Button>
                                    </Grid>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ==================================================== Laser tab -->
                    <TabItem>
                        <TabItem.Header>
                            <c:Glyph Data="{StaticResource I.Laser}" Text="Laser" Size="15" />
                        </TabItem.Header>
                        <DockPanel Margin="12,2,12,12">
                            <StackPanel DockPanel.Dock="Top">
                                <GroupBox Header="Connection">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="92" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="PortCombo" ToolTip="USB serial port, or the built-in simulator to try things without a laser" />
                                            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Click="RefreshPorts_Click" ToolTip="Refresh ports"><c:Glyph Data="{StaticResource I.Update}" Size="15" /></Button>
                                            <ComboBox x:Name="BaudCombo" Grid.Column="2" IsEditable="True" Text="115200" ToolTip="Baud rate">
                                                <ComboBoxItem>115200</ComboBoxItem>
                                                <ComboBoxItem>250000</ComboBoxItem>
                                                <ComboBoxItem>230400</ComboBoxItem>
                                                <ComboBoxItem>57600</ComboBoxItem>
                                            </ComboBox>
                                        </Grid>
                                        <DockPanel Margin="0,6,0,0">
                                            <Button x:Name="ConnectButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" MinWidth="130" Click="Connect_Click">
                                                <c:Glyph x:Name="ConnectGlyph" Data="{StaticResource I.Plug}" Text="Connect" Size="15" />
                                            </Button>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse x:Name="ConnDotLarge" Width="9" Height="9" Fill="{StaticResource Brush.TextDim}" Margin="4,0,8,0" />
                                                <TextBlock x:Name="ConnStateText" Text="Not connected" Foreground="{StaticResource Brush.TextMuted}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="Machine">
                                    <StackPanel>
                                        <WrapPanel>
                                            <Button Click="Home_Click" ToolTip="Home ($H)"><c:Glyph Data="{StaticResource I.Home}" Text="Home" Size="15" /></Button>
                                            <Button Click="Unlock_Click" ToolTip="Clear an alarm lock ($X)"><c:Glyph Data="{StaticResource I.Unlock}" Text="Unlock" Size="15" /></Button>
                                            <Button Click="SetOrigin_Click" ToolTip="G10 L20 P1 X0 Y0 – the head position becomes the user origin">
                                                <c:Glyph Data="{StaticResource I.Target}" Text="Set origin here" Size="15" />
                                            </Button>
                                        </WrapPanel>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="132" Height="132">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition /><RowDefinition /><RowDefinition />
                                                </Grid.RowDefinitions>
                                                <Button Grid.Column="1" Tag="0,1" Click="Jog_Click" Padding="0" ToolTip="Jog +Y (away from you)"><c:Glyph Data="{StaticResource I.ChevronUp}" /></Button>
                                                <Button Grid.Row="1" Tag="-1,0" Click="Jog_Click" Padding="0" ToolTip="Jog −X"><c:Glyph Data="{StaticResource I.ChevronLeft}" /></Button>
                                                <Button Grid.Row="1" Grid.Column="1" Click="JogCancel_Click" Padding="0" ToolTip="Stop jogging" Style="{StaticResource DangerButton}"><c:Glyph Data="{StaticResource I.Stop}" Size="14" /></Button>
                                                <Button Grid.Row="1" Grid.Column="2" Tag="1,0" Click="Jog_Click" Padding="0" ToolTip="Jog +X"><c:Glyph Data="{StaticResource I.ChevronRight}" /></Button>
                                                <Button Grid.Row="2" Grid.Column="1" Tag="0,-1" Click="Jog_Click" Padding="0" ToolTip="Jog −Y (towards you)"><c:Glyph Data="{StaticResource I.ChevronDown}" /></Button>
                                            </Grid>
                                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="STEP (MM)" Style="{StaticResource Caption}" Margin="2,0,2,2" />
                                                <ComboBox x:Name="JogStepCombo" SelectedIndex="2">
                                                    <ComboBoxItem>0.1</ComboBoxItem>
                                                    <ComboBoxItem>1</ComboBoxItem>
                                                    <ComboBoxItem>10</ComboBoxItem>
                                                    <ComboBoxItem>50</ComboBoxItem>
                                                </ComboBox>
                                                <TextBlock Text="JOG SPEED (MM/MIN)" Style="{StaticResource Caption}" Margin="2,8,2,2" />
                                                <TextBox x:Name="JogFeedBox" Text="3000" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="Job">
                                    <StackPanel>
                                        <TextBlock Text="START FROM" Style="{StaticResource Caption}" Margin="2,0,2,4" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <ComboBox x:Name="OriginCombo" SelectionChanged="Origin_Changed" />
                                                <TextBlock x:Name="OriginHint" Style="{StaticResource Muted}" FontSize="11.5" Margin="3,4,3,0" />
                                            </StackPanel>
                                            <UniformGrid x:Name="AnchorGrid" Grid.Column="1" Rows="3" Columns="3" Margin="12,2,0,0" VerticalAlignment="Top"
                                                         ToolTip="Which point of the job sits at the origin">
                                                <RadioButton GroupName="anchor" Tag="TopLeft" Style="{StaticResource AnchorCell}" Checked="Anchor_Checked" />
                                                <RadioButton GroupName="anchor" Tag="TopCenter" Style="{StaticResource AnchorCell}" Checked="Anchor_Checked" />
                                                <RadioButton GroupName="anchor" Tag="TopRight" Style="{StaticResource AnchorCell}" Checked="Anchor_Checked" />
                                                <RadioButton GroupName="anchor" Tag="MiddleLeft" Style="{StaticResource AnchorCell}" Checked="Anchor_Checked" />
                                                <RadioButton GroupName="anchor" Tag="Center" Style="{StaticResource AnchorCell}" Checked="Anchor_Checked" />
                                                <RadioButton GroupName="anchor" Tag="MiddleRight" Style="{StaticResource AnchorCell}" Checked="Anchor_Checked" />
                                                <RadioButton GroupName="anchor" Tag="BottomLeft" Style="{StaticResource AnchorCell}" Checked="Anchor_Checked" />
                                                <RadioButton GroupName="anchor" Tag="BottomCenter" Style="{StaticResource AnchorCell}" Checked="Anchor_Checked" />
                                                <RadioButton GroupName="anchor" Tag="BottomRight" Style="{StaticResource AnchorCell}" Checked="Anchor_Checked" />
                                            </UniformGrid>
                                        </Grid>

                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Label Content="Frame power %" />
                                            <TextBox x:Name="FramePowerBox" Grid.Column="1" Text="0" ToolTip="0 = head moves only. 1–2 % shows a faint dot on most diode lasers without marking (capped at 5 %)." />
                                            <Label Grid.Column="2" Content="mm/min" Margin="6,0,0,0" />
                                            <TextBox x:Name="FrameSpeedBox" Grid.Column="3" Text="3000" />
                                        </Grid>
                                        <CheckBox x:Name="SelectedOnlyCheck" Content="Burn and frame the selection only" />

                                        <UniformGrid Rows="1" Margin="0,8,0,0">
                                            <Button Click="Frame_Click" ToolTip="Trace the job outline to check size and placement before burning">
                                                <c:Glyph Data="{StaticResource I.Frame}" Text="Frame" Size="15" />
                                            </Button>
                                            <Button Click="Simulate_Click" ToolTip="Play the job in the simulated preview">
                                                <c:Glyph Data="{StaticResource I.Simulate}" Text="Preview" Size="15" />
                                            </Button>
                                        </UniformGrid>
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" /><ColumnDefinition /><ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" MinHeight="40" Click="Start_Click" ToolTip="Check the job and start burning">
                                                <c:Glyph Data="{StaticResource I.Play}" Text="Start" Size="16" />
                                            </Button>
                                            <Button x:Name="PauseButton" Grid.Column="1" MinHeight="40" Click="Pause_Click" IsEnabled="False" ToolTip="Feed hold / resume">
                                                <c:Glyph x:Name="PauseGlyph" Data="{StaticResource I.Pause}" Text="Pause" Size="15" />
                                            </Button>
                                            <Button x:Name="StopButton" Grid.Column="2" MinHeight="40" Style="{StaticResource DangerButton}" Click="Stop_Click" ToolTip="Stop now (feed hold + soft reset)">
                                                <c:Glyph Data="{StaticResource I.Stop}" Text="Stop" Size="15" />
                                            </Button>
                                        </Grid>
                                        <ProgressBar x:Name="JobProgress" Margin="2,12,2,4" />
                                        <DockPanel>
                                            <TextBlock x:Name="JobEtaText" DockPanel.Dock="Right" Foreground="{StaticResource Brush.TextMuted}" FontFamily="{StaticResource Font.Mono}" FontSize="12" />
                                            <TextBlock x:Name="JobProgressText" Margin="2" Text="Idle" Foreground="{StaticResource Brush.TextMuted}" />
                                        </DockPanel>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="Console">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Click="SendCommand_Click" ToolTip="Send"><c:Glyph Data="{StaticResource I.Send}" Size="15" /></Button>
                                        <TextBox x:Name="CommandBox" KeyDown="CommandBox_KeyDown" FontFamily="{StaticResource Font.Mono}"
                                                 ToolTip="Any GRBL command, e.g. $$ to list settings" />
                                    </DockPanel>
                                </GroupBox>
                            </StackPanel>
                            <ListBox x:Name="ConsoleList" FontFamily="{StaticResource Font.Mono}" FontSize="11.5" MinHeight="90" />
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- ============================================================ status bar -->
        <Border Grid.Row="3" Background="{StaticResource Brush.HeaderGradient}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Padding="12,4">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Border x:Name="OriginChip" Style="{StaticResource Chip}" ToolTip="Where the job starts – change it on the Laser tab">
                        <StackPanel Orientation="Horizontal">
                            <c:Glyph Data="{StaticResource I.Target}" Size="13" Foreground="{StaticResource Brush.Info}" Margin="0,0,6,0" />
                            <TextBlock x:Name="OriginChipText" Text="Absolute" FontSize="12" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Chip}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ConnDot" Width="8" Height="8" Fill="{StaticResource Brush.TextDim}" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="MachineText" Text="Not connected" FontSize="12" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="CursorText" Text="X 0.0  Y 0.0 mm" MinWidth="130" FontFamily="{StaticResource Font.Mono}" FontSize="12" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" />
                    <Border Style="{StaticResource VDivider}" Margin="10,3" />
                    <TextBlock x:Name="SelectionText" Text="Nothing selected" MinWidth="200" FontSize="12" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" />
                    <Border Style="{StaticResource VDivider}" Margin="10,3" />
                    <TextBlock x:Name="JobText" FontSize="12" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
