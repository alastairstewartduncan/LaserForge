<Window x:Class="AsdLasercraft.App.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="A·S·D Lasercraft" Width="700" Height="420"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True" Icon="/Assets/AsdLasercraft.ico"
        FontFamily="{StaticResource Font.UI}" UseLayoutRounding="True">
    <Grid x:Name="Root" Margin="24" Opacity="0">
        <!-- card -->
        <Border CornerRadius="18" BorderThickness="1" BorderBrush="#2EFFFFFF">
            <Border.Background>
                <RadialGradientBrush GradientOrigin="0.5,0.2" Center="0.5,0.35" RadiusX="0.85" RadiusY="1.1">
                    <GradientStop Color="#2A2F3B" Offset="0" />
                    <GradientStop Color="#15181E" Offset="0.55" />
                    <GradientStop Color="#0A0B0E" Offset="1" />
                </RadialGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.6" Color="Black" />
            </Border.Effect>
        </Border>

        <!-- engraving-bed grid -->
        <Border CornerRadius="18" Opacity="0.5" ClipToBounds="True">
            <Border.Background>
                <DrawingBrush TileMode="Tile" Viewport="0,0,22,22" ViewportUnits="Absolute">
                    <DrawingBrush.Drawing>
                        <GeometryDrawing Geometry="M0,0 L22,0 M0,0 L0,22">
                            <GeometryDrawing.Pen>
                                <Pen Brush="#14FFFFFF" Thickness="1" />
                            </GeometryDrawing.Pen>
                        </GeometryDrawing>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Border.Background>
            <Border.OpacityMask>
                <RadialGradientBrush Center="0.5,0.45" RadiusX="0.7" RadiusY="0.8">
                    <GradientStop Color="Black" Offset="0" />
                    <GradientStop Color="Transparent" Offset="1" />
                </RadialGradientBrush>
            </Border.OpacityMask>
        </Border>

        <Canvas x:Name="Stage" ClipToBounds="True" Margin="1">
            <!-- gantry rail -->
            <Border x:Name="Rail" Canvas.Top="58" Height="4" CornerRadius="2">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00394150" Offset="0" />
                        <GradientStop Color="#FF394150" Offset="0.12" />
                        <GradientStop Color="#FF394150" Offset="0.88" />
                        <GradientStop Color="#00394150" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- engraved title (revealed left to right) -->
            <StackPanel x:Name="TitlePanel" Canvas.Top="104">
                <StackPanel.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop x:Name="RevealA" Color="Black" Offset="0" />
                        <GradientStop x:Name="RevealB" Color="Transparent" Offset="0.001" />
                    </LinearGradientBrush>
                </StackPanel.OpacityMask>
                <TextBlock x:Name="TitleText" Text="A·S·D" FontSize="80" FontWeight="Black" HorizontalAlignment="Center"
                           FontFamily="{StaticResource Font.Display}">
                    <TextBlock.Foreground>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FFB066" Offset="0" />
                            <GradientStop Color="#FF7A1A" Offset="0.55" />
                            <GradientStop Color="#D9520A" Offset="1" />
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                </TextBlock>
                <TextBlock Text="L A S E R C R A F T" FontSize="26" FontWeight="SemiBold" Foreground="#C9D0DC"
                           HorizontalAlignment="Center" Margin="0,-6,0,0" FontFamily="{StaticResource Font.Display}" />
            </StackPanel>

            <!-- hot ember edge that trails the beam -->
            <StackPanel x:Name="EmberPanel" Canvas.Top="104" IsHitTestVisible="False">
                <StackPanel.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop x:Name="EmberA" Color="Transparent" Offset="0" />
                        <GradientStop x:Name="EmberB" Color="Black" Offset="0.0005" />
                        <GradientStop x:Name="EmberC" Color="Transparent" Offset="0.001" />
                    </LinearGradientBrush>
                </StackPanel.OpacityMask>
                <StackPanel.Effect>
                    <DropShadowEffect Color="#FF8A2A" BlurRadius="16" ShadowDepth="0" Opacity="1" />
                </StackPanel.Effect>
                <TextBlock Text="A·S·D" FontSize="80" FontWeight="Black" HorizontalAlignment="Center" Foreground="#FFE2BF"
                           FontFamily="{StaticResource Font.Display}" />
                <TextBlock Text="L A S E R C R A F T" FontSize="26" FontWeight="SemiBold" Foreground="#FFE2BF"
                           HorizontalAlignment="Center" Margin="0,-6,0,0" FontFamily="{StaticResource Font.Display}" />
            </StackPanel>

            <!-- beam -->
            <Rectangle x:Name="Beam" Width="3" Height="40" Canvas.Top="96" Opacity="0" RadiusX="1.5" RadiusY="1.5">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00FF7A1A" Offset="0" />
                        <GradientStop Color="#CCFF8A30" Offset="0.4" />
                        <GradientStop Color="#FFFFE6CC" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
                <Rectangle.Effect>
                    <DropShadowEffect Color="#FF7A1A" BlurRadius="12" ShadowDepth="0" Opacity="1" />
                </Rectangle.Effect>
            </Rectangle>

            <!-- sparks are added here from code -->
            <Canvas x:Name="Sparks" IsHitTestVisible="False">
                <Canvas.Effect>
                    <DropShadowEffect Color="#FF9A3D" BlurRadius="8" ShadowDepth="0" Opacity="0.9" />
                </Canvas.Effect>
            </Canvas>

            <!-- beam spot -->
            <Ellipse x:Name="Dot" Width="22" Height="22" Opacity="0" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#FFFFFFFF" Offset="0" />
                        <GradientStop Color="#FFFFD2A0" Offset="0.25" />
                        <GradientStop Color="#AAFF7A1A" Offset="0.55" />
                        <GradientStop Color="#00FF7A1A" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect>
                    <DropShadowEffect Color="#FF7A1A" BlurRadius="26" ShadowDepth="0" Opacity="1" />
                </Ellipse.Effect>
            </Ellipse>

            <!-- laser head on the gantry -->
            <Grid x:Name="Head" Canvas.Top="38" Width="52" Height="58">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="HeadShift" X="40" />
                </Grid.RenderTransform>
                <Border Height="34" VerticalAlignment="Top" CornerRadius="7" BorderThickness="1" BorderBrush="#4A5363">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#3C4352" Offset="0" />
                            <GradientStop Color="#232831" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Border Height="2" Margin="8,0,8,7" VerticalAlignment="Bottom" CornerRadius="1" Background="#1AFFFFFF" />
                        <Ellipse x:Name="Led" Width="6" Height="6" Fill="#FF7A1A" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,7,0">
                            <Ellipse.Effect>
                                <DropShadowEffect x:Name="LedGlow" Color="#FF7A1A" BlurRadius="8" ShadowDepth="0" Opacity="1" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock Text="ASD" FontSize="9" FontWeight="Bold" Foreground="#7A8396" HorizontalAlignment="Left"
                                   VerticalAlignment="Top" Margin="7,5,0,0" />
                    </Grid>
                </Border>
                <Path Data="M18,34 L34,34 L30,46 L22,46 Z" Fill="#2B313D" Stroke="#4A5363" StrokeThickness="1" />
                <Path Data="M23,46 L29,46 L27.5,52 L24.5,52 Z" Fill="#1A1E25" Stroke="#4A5363" StrokeThickness="1" />
            </Grid>
        </Canvas>

        <!-- footer -->
        <Grid VerticalAlignment="Bottom" Margin="34,0,34,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel>
                <TextBlock x:Name="VersionText" DockPanel.Dock="Right" Foreground="#646C7E" FontSize="11.5" VerticalAlignment="Bottom" />
                <TextBlock x:Name="StatusText" Foreground="#9AA3B5" FontSize="12.5" Text="Warming up the diode…" />
            </DockPanel>
            <Grid Grid.Row="1" Height="3" Margin="0,10,0,0">
                <Border CornerRadius="1.5" Background="#222731" />
                <Border x:Name="ProgressFill" CornerRadius="1.5" HorizontalAlignment="Left" Width="0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FF9A3D" Offset="0" />
                            <GradientStop Color="#FF6A00" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect Color="#FF7A1A" BlurRadius="8" ShadowDepth="0" Opacity="0.9" />
                    </Border.Effect>
                </Border>
            </Grid>
        </Grid>
        <TextBlock Text="DESIGN  ·  ENGRAVE  ·  CUT" Foreground="#6B7385" FontSize="11.5" FontWeight="SemiBold"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,82" />
    </Grid>
</Window>
