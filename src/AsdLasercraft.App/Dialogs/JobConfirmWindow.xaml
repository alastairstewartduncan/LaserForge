<Window x:Class="AsdLasercraft.App.Dialogs.JobConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:AsdLasercraft.App.Controls"
        Style="{StaticResource AppWindow}"
        Title="Ready to burn" Width="540" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel>
        <!-- header -->
        <Border Background="{StaticResource Brush.HeaderGradient}" Padding="24,20" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="52" Height="52" CornerRadius="14" Background="{StaticResource Brush.AccentSoft}" Margin="0,0,16,0">
                    <c:Glyph x:Name="HeaderIcon" Data="{StaticResource I.Laser}" Size="28" Foreground="{StaticResource Brush.Accent}" HorizontalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="Ready to burn" FontSize="19" FontWeight="SemiBold" FontFamily="{StaticResource Font.Display}" />
                    <TextBlock x:Name="SubtitleText" Style="{StaticResource Muted}" Margin="0,3,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- stats -->
        <UniformGrid Rows="1" Margin="20,18,20,4">
            <Border Background="{StaticResource Brush.Panel}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="SIZE" Style="{StaticResource Caption}" Margin="0" />
                    <TextBlock x:Name="SizeText" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Background="{StaticResource Brush.Panel}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="3,0">
                <StackPanel>
                    <TextBlock Text="ESTIMATED TIME" Style="{StaticResource Caption}" Margin="0" />
                    <TextBlock x:Name="TimeText" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0" Foreground="{StaticResource Brush.Accent}" />
                </StackPanel>
            </Border>
            <Border Background="{StaticResource Brush.Panel}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="6,0,0,0">
                <StackPanel>
                    <TextBlock Text="BURN DISTANCE" Style="{StaticResource Caption}" Margin="0" />
                    <TextBlock x:Name="DistanceText" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- checks -->
        <TextBlock x:Name="ChecksCaption" Text="PRE-FLIGHT CHECKS" Style="{StaticResource Caption}" Margin="22,14,22,4" />
        <StackPanel x:Name="IssuesPanel" Margin="20,0,20,0" />

        <!-- safety -->
        <Border x:Name="SafetyBox" Margin="20,14,20,0" Padding="14,10" CornerRadius="10" BorderThickness="1" BorderBrush="#4DFFC145" Background="#14FFC145">
            <DockPanel>
                <c:Glyph DockPanel.Dock="Left" Data="{StaticResource I.Warning}" Foreground="{StaticResource Brush.Warning}" Size="18" Margin="0,1,10,0" VerticalAlignment="Top" />
                <TextBlock TextWrapping="Wrap" Foreground="#E8D3A0" FontSize="12.5"
                           Text="Wear safety glasses rated for your laser's wavelength, keep a fire extinguisher nearby and never leave the laser unattended." />
            </DockPanel>
        </Border>

        <!-- buttons -->
        <DockPanel Margin="20,18,20,20" LastChildFill="False">
            <Button x:Name="SimulateButton" DockPanel.Dock="Left" Click="Simulate_Click" ToolTip="Play the job in the preview first">
                <c:Glyph Data="{StaticResource I.Simulate}" Text="Preview first" Size="16" />
            </Button>
            <Button x:Name="StartButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" MinWidth="150" IsDefault="True" Click="Start_Click">
                <c:Glyph x:Name="StartIcon" Data="{StaticResource I.Play}" Text="Start burning" Size="16" />
            </Button>
            <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" MinWidth="90" Margin="2,2,8,2" />
        </DockPanel>
    </StackPanel>
</Window>
