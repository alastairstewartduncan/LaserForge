<Window x:Class="AsdLasercraft.App.Dialogs.MaterialLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:AsdLasercraft.App.Controls"
        Style="{StaticResource AppWindow}"
        Title="Material library" Width="980" Height="600" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel>
        <!-- header -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Brush.HeaderGradient}" Padding="22,16" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="12" Background="{StaticResource Brush.AccentSoft}" Margin="0,0,14,0">
                    <c:Glyph Data="{StaticResource I.Material}" Size="22" Foreground="{StaticResource Brush.Accent}" HorizontalAlignment="Center" />
                </Border>
                <Grid DockPanel.Dock="Right" Width="240" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox" TextChanged="Search_Changed" Padding="30,0,8,0" ToolTip="Filter by material, operation or notes" />
                    <c:Glyph Data="{StaticResource I.Search}" Size="14" Foreground="{StaticResource Brush.TextDim}" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False" />
                </Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Material library" FontSize="18" FontWeight="SemiBold" FontFamily="{StaticResource Font.Display}" />
                    <TextBlock x:Name="SubtitleText" Style="{StaticResource Muted}" Margin="0,2,0,0"
                               Text="Saved speed and power for each material. Pick one and apply it to the selected layer." />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- footer -->
        <DockPanel DockPanel.Dock="Bottom" Margin="16,10,16,16" LastChildFill="False">
            <Button DockPanel.Dock="Left" Click="AddFromLayer_Click" ToolTip="Save the selected layer's settings as a new preset">
                <c:Glyph Data="{StaticResource I.Plus}" Text="Save layer as preset" Size="15" />
            </Button>
            <Button DockPanel.Dock="Left" Click="Duplicate_Click">
                <c:Glyph Data="{StaticResource I.Duplicate}" Text="Duplicate" Size="15" />
            </Button>
            <Button DockPanel.Dock="Left" Style="{StaticResource DangerButton}" Click="Delete_Click">
                <c:Glyph Data="{StaticResource I.Delete}" Text="Delete" Size="15" />
            </Button>
            <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Click="Restore_Click" Content="Restore defaults" />
            <Button x:Name="ApplyButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Click="Apply_Click" MinWidth="170">
                <c:Glyph x:Name="ApplyGlyph" Data="{StaticResource I.Check}" Text="Apply to layer" Size="15" />
            </Button>
            <Button DockPanel.Dock="Right" Content="Close" IsCancel="True" MinWidth="90" Margin="2,2,8,2" />
        </DockPanel>

        <Border Margin="16,12,16,0" Background="{StaticResource Brush.Panel}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="10" Padding="6">
            <DataGrid x:Name="PresetsGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      SelectionMode="Single" MouseDoubleClick="PresetsGrid_DoubleClick" CellEditEnding="PresetsGrid_CellEditEnding">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Material" Binding="{Binding Material}" Width="2*" />
                    <DataGridTextColumn Header="mm" Binding="{Binding ThicknessMm}" Width="50" />
                    <DataGridTextColumn Header="Operation" Binding="{Binding Operation}" Width="*" />
                    <DataGridComboBoxColumn x:Name="ModeColumn" Header="Mode" SelectedItemBinding="{Binding Mode}" Width="74" />
                    <DataGridTextColumn Header="mm/min" Binding="{Binding SpeedMmMin}" Width="66" />
                    <DataGridTextColumn Header="Power %" Binding="{Binding PowerPercent}" Width="64" />
                    <DataGridTextColumn Header="Passes" Binding="{Binding Passes}" Width="54" />
                    <DataGridTextColumn Header="Interval" Binding="{Binding LineIntervalMm}" Width="58" />
                    <DataGridCheckBoxColumn Header="Air" Binding="{Binding AirAssist}" Width="40"
                                            ElementStyle="{StaticResource {x:Type CheckBox}}" EditingElementStyle="{StaticResource {x:Type CheckBox}}" />
                    <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="2.4*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</Window>
