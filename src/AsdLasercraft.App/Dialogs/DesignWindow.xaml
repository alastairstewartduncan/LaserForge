<Window x:Class="AsdLasercraft.App.Dialogs.DesignWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:AsdLasercraft.App.Controls"
        Style="{StaticResource AppWindow}"
        Title="Describe a design" Width="980" Height="640" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- header -->
        <Border Background="{StaticResource Brush.HeaderGradient}" Padding="22,16" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="12" Background="{StaticResource Brush.AccentSoft}" Margin="0,0,14,0">
                    <c:Glyph Data="{StaticResource I.Sparkle}" Size="24" Foreground="{StaticResource Brush.Accent}" HorizontalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Describe it, get vectors" FontSize="18" FontWeight="SemiBold" FontFamily="{StaticResource Font.Display}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0" Text="Say what you want to engrave or cut – Claude draws it as editable vector shapes." />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- brief -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,16,14,12">
                    <TextBlock Text="WHAT SHOULD IT LOOK LIKE?" Style="{StaticResource Caption}" Margin="2,0,2,4" />
                    <TextBox x:Name="PromptBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" MaxHeight="200" VerticalContentAlignment="Top" Padding="8,6"
                             TextChanged="PromptBox_TextChanged"
                             ToolTip="Describe the design. Put any exact wording in quotes." />
                    <TextBlock Text="IDEAS" Style="{StaticResource Caption}" Margin="2,10,2,6" />
                    <WrapPanel x:Name="ExamplesPanel" />

                    <TextBlock Text="SIZE (MM)" Style="{StaticResource Caption}" Margin="2,10,2,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Label Content="Width" />
                        <TextBox x:Name="WidthBox" Grid.Column="1" Text="80" />
                        <Label Content="Height" Grid.Column="2" Margin="8,0,0,0" />
                        <TextBox x:Name="HeightBox" Grid.Column="3" Text="" ToolTip="Leave empty to let the design choose its height" />
                    </Grid>

                    <TextBlock Text="STYLE" Style="{StaticResource Caption}" Margin="2,12,2,4" />
                    <RadioButton x:Name="StyleEngrave" GroupName="style" IsChecked="True" Style="{StaticResource OptionRadio}">
                        <TextBlock><Run Text="Engrave" FontWeight="SemiBold" /><Run Text="  – solid shapes and lettering" Foreground="{StaticResource Brush.TextMuted}" /></TextBlock>
                    </RadioButton>
                    <RadioButton x:Name="StyleLine" GroupName="style" Style="{StaticResource OptionRadio}">
                        <TextBlock><Run Text="Line art" FontWeight="SemiBold" /><Run Text="  – outlines to score or cut" Foreground="{StaticResource Brush.TextMuted}" /></TextBlock>
                    </RadioButton>
                    <RadioButton x:Name="StyleBoth" GroupName="style" Style="{StaticResource OptionRadio}">
                        <TextBlock><Run Text="Engrave + cut out" FontWeight="SemiBold" /><Run Text="  – coasters, tags, ornaments" Foreground="{StaticResource Brush.TextMuted}" /></TextBlock>
                    </RadioButton>

                    <Button x:Name="GenerateButton" Style="{StaticResource PrimaryButton}" MinHeight="40" Margin="2,16,2,2" Click="Generate_Click" IsEnabled="False">
                        <c:Glyph x:Name="GenerateGlyph" Data="{StaticResource I.Sparkle}" Text="Create design" Size="16" />
                    </Button>
                </StackPanel>
            </ScrollViewer>

            <!-- preview -->
            <Border Grid.Column="1" Margin="0,16,20,12" CornerRadius="12" Background="{StaticResource Brush.Bg0}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <c:VectorPreview x:Name="Preview" Margin="6" />

                    <!-- empty / busy / error states -->
                    <StackPanel x:Name="PlaceholderPanel" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="360">
                        <c:Glyph x:Name="PlaceholderGlyph" Data="{StaticResource I.Sparkle}" Size="40" Foreground="{StaticResource Brush.TextDim}" HorizontalAlignment="Center" />
                        <TextBlock x:Name="PlaceholderText" Margin="0,12,0,0" TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource Brush.TextMuted}"
                                   Text="Your design will appear here. Try one of the ideas on the left to get started." />
                        <ProgressBar x:Name="BusyBar" IsIndeterminate="True" Width="220" Margin="0,14,0,0" Visibility="Collapsed" />
                    </StackPanel>

                    <!-- refine -->
                    <Border x:Name="RefinePanel" Grid.Row="1" Padding="12,10" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="NotesText" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="2,0,2,8" />
                            <DockPanel>
                                <Button x:Name="RefineButton" DockPanel.Dock="Right" Click="Refine_Click" ToolTip="Ask for a change to this design">
                                    <c:Glyph Data="{StaticResource I.Send}" Text="Change it" Size="14" />
                                </Button>
                                <TextBox x:Name="RefineBox" KeyDown="RefineBox_KeyDown" ToolTip="e.g. make the text bigger, add a border, simplify the leaves" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2" Margin="20,0,20,18" LastChildFill="False">
            <TextBlock x:Name="FooterText" DockPanel.Dock="Left" VerticalAlignment="Center" Style="{StaticResource Muted}" FontSize="12"
                       Text="Only your description is sent to Claude." />
            <Button x:Name="AddButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" MinWidth="160" IsEnabled="False" Click="Add_Click">
                <c:Glyph Data="{StaticResource I.Plus}" Text="Add to my design" Size="15" />
            </Button>
            <Button DockPanel.Dock="Right" Content="Close" IsCancel="True" MinWidth="90" Margin="2,2,8,2" />
        </DockPanel>
    </Grid>
</Window>
