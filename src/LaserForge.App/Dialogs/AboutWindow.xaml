<Window x:Class="LaserForge.App.Dialogs.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About LaserForge" Width="460" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="/Assets/LaserForge.ico">
    <StackPanel>
        <!-- Header -->
        <Border Padding="24,22">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#232733" Offset="0" />
                    <GradientStop Color="#0E1015" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel Orientation="Horizontal">
                <Image Source="/Assets/logo-256.png" Width="88" Height="88" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock FontSize="34" FontFamily="Segoe UI">
                        <Run Text="Laser" Foreground="#AEB6C6" FontWeight="Light" /><Run Text="Forge" Foreground="#FF8F33" FontWeight="Bold" />
                    </TextBlock>
                    <TextBlock Text="DESIGN · ENGRAVE · CUT" Foreground="#7A8396" FontSize="11" Margin="2,2,0,0" />
                    <TextBlock x:Name="VersionText" Foreground="#E3E7EE" FontSize="13" Margin="2,10,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Details -->
        <Grid Margin="24,18,24,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
            </Grid.RowDefinitions>
            <Grid.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Margin" Value="0,3" />
                    <Setter Property="TextWrapping" Value="Wrap" />
                </Style>
            </Grid.Resources>

            <TextBlock Text="Author" Foreground="Gray" Margin="0,3,16,3" />
            <TextBlock x:Name="AuthorText" Grid.Column="1" FontWeight="SemiBold" />

            <TextBlock Grid.Row="1" Text="Email" Foreground="Gray" Margin="0,3,16,3" />
            <TextBlock Grid.Row="1" Grid.Column="1">
                <Hyperlink x:Name="EmailLink" RequestNavigate="Link_RequestNavigate"><Run x:Name="EmailText" /></Hyperlink>
            </TextBlock>

            <TextBlock Grid.Row="2" Text="Source" Foreground="Gray" Margin="0,3,16,3" />
            <TextBlock Grid.Row="2" Grid.Column="1">
                <Hyperlink x:Name="RepoLink" RequestNavigate="Link_RequestNavigate"><Run x:Name="RepoText" /></Hyperlink>
            </TextBlock>

            <TextBlock Grid.Row="3" Text="Version" Foreground="Gray" Margin="0,3,16,3" />
            <TextBlock x:Name="FullVersionText" Grid.Row="3" Grid.Column="1" />

            <TextBlock Grid.Row="4" Text="Runtime" Foreground="Gray" Margin="0,3,16,3" />
            <TextBlock x:Name="RuntimeText" Grid.Row="4" Grid.Column="1" />

            <TextBlock x:Name="DescriptionText" Grid.Row="5" Grid.ColumnSpan="2" Margin="0,12,0,0" Foreground="#444" />
        </Grid>

        <TextBlock x:Name="CopyrightText" Margin="24,8,24,0" Foreground="Gray" FontSize="11" TextWrapping="Wrap" />
        <TextBlock Margin="24,4,24,0" Foreground="Gray" FontSize="11" TextWrapping="Wrap"
                   Text="Lasers cause fires and permanent eye damage. Wear glasses rated for your laser's wavelength and never leave a job unattended." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,16,24,20">
            <Button Content="Copy details" Click="Copy_Click" MinWidth="100" />
            <Button Content="Close" IsDefault="True" IsCancel="True" Click="Close_Click" MinWidth="90" />
        </StackPanel>
    </StackPanel>
</Window>
