<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LaserForge.App</RootNamespace>
    <AssemblyName>LaserForge</AssemblyName>
    <ApplicationTitle>LaserForge</ApplicationTitle>
    <ApplicationIcon>Assets\LaserForge.ico</ApplicationIcon>
    <!-- Lets the solution restore/build on non-Windows CI agents too (the app only runs on Windows). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\LaserForge.ico" />
    <Resource Include="Assets\logo-256.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LaserForge.Core\LaserForge.Core.csproj" />
  </ItemGroup>

</Project>
